[app]

title = Ball Escape
package.name = ballescape
package.domain = org.bfgames

source.dir = .
source.include_exts = py,png,jpg,jpeg,kv,atlas,json

version = 1.0

requirements = python3,kivy

orientation = landscape
fullscreen = 1

android.api = 36
android.minapi = 23
android.archs = arm64-v8a, armeabi-v7a

[buildozer]

log_level = 2
warn_on_root = 1
